# Required: use the PM2 state directory belonging to the host user whose services to manage.
# Windows example: C:\Users\<user>\.pm2
# Linux/macOS example: /home/<user>/.pm2
PM2_HOME=/absolute/path/to/.pm2

# Required: replace each placeholder with a different random secret of at least 32 characters.
PM2_MCP_READ_TOKEN=replace-with-a-random-read-token-of-at-least-32-characters
PM2_MCP_WRITE_TOKEN=replace-with-a-different-random-write-token-of-at-least-32-characters

# HTTP is intended for Docker clients connecting to the host on port 8486.
# Restrict access to this plaintext endpoint with the host firewall.
PM2_MCP_TRANSPORT=http
PM2_MCP_HOST=0.0.0.0
PM2_MCP_PORT=8486
PM2_MCP_PATH=/mcp
PM2_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Keep false unless this server is explicitly allowed to start a persistent PM2 daemon.
PM2_MCP_ALLOW_DAEMON_START=false

# Optional: maps allowlisted names to fixed PM2 script definitions for start_service.
PM2_MCP_START_TARGETS_JSON={}

# Stdio only: defaults to read-only; set to write to expose mutation tools.
PM2_MCP_STDIO_ACCESS=read

# TEST
RUN_PM2_INTEGRATION=0